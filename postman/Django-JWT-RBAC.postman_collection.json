{
  "info": {
    "name": "Django JWT Auth RBAC API",
    "description": "Login, register, users, profile, and role-scoped task CRUD for the Admin/Manager/User RBAC API. Run the Auth requests first to populate the admin/manager/user token variables via test scripts, then exercise the rest.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b3e6a6b0-6b8b-4a1a-9f3f-django-jwt-rbac"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "admin_username", "value": "admin" },
    { "key": "admin_password", "value": "AdminPass123" },
    { "key": "manager_username", "value": "mgr_sales" },
    { "key": "manager_password", "value": "MgrPass123" },
    { "key": "user_username", "value": "alice" },
    { "key": "user_password", "value": "UserPass123" },
    { "key": "admin_access", "value": "" },
    { "key": "manager_access", "value": "" },
    { "key": "user_access", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "manager_id", "value": "" },
    { "key": "task_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('admin_access', data.access);",
                  "pm.collectionVariables.set('refresh_token', data.refresh);",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/token/", "host": ["{{base_url}}"], "path": ["api", "token", ""] }
          }
        },
        {
          "name": "Login - Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('manager_access', data.access);",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{manager_username}}\",\n  \"password\": \"{{manager_password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/token/", "host": ["{{base_url}}"], "path": ["api", "token", ""] }
          }
        },
        {
          "name": "Login - User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('user_access', data.access);",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{user_username}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/token/", "host": ["{{base_url}}"], "path": ["api", "token", ""] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/token/refresh/", "host": ["{{base_url}}"], "path": ["api", "token", "refresh", ""] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Register User (Admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_access}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"erin\",\n  \"password\": \"UserPass123\",\n  \"role\": \"USER\",\n  \"manager\": {{manager_id}}\n}"
            },
            "url": { "raw": "{{base_url}}/api/register/", "host": ["{{base_url}}"], "path": ["api", "register", ""] }
          }
        },
        {
          "name": "List Users - as Admin (sees all)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_access}}" }] },
            "url": { "raw": "{{base_url}}/api/users/", "host": ["{{base_url}}"], "path": ["api", "users", ""] }
          }
        },
        {
          "name": "List Users - as Manager (own team only)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{manager_access}}" }] },
            "url": { "raw": "{{base_url}}/api/users/", "host": ["{{base_url}}"], "path": ["api", "users", ""] }
          }
        },
        {
          "name": "List Users - as User (expect 403)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{user_access}}" }] },
            "url": { "raw": "{{base_url}}/api/users/", "host": ["{{base_url}}"], "path": ["api", "users", ""] }
          }
        },
        {
          "name": "Get User Detail - as Manager (own team member)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{manager_access}}" }] },
            "url": { "raw": "{{base_url}}/api/users/{{user_id}}/", "host": ["{{base_url}}"], "path": ["api", "users", "{{user_id}}", ""] }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{user_access}}" }] },
            "url": { "raw": "{{base_url}}/api/profile/", "host": ["{{base_url}}"], "path": ["api", "profile", ""] }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{user_access}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Alice\",\n  \"last_name\": \"Nguyen\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/profile/", "host": ["{{base_url}}"], "path": ["api", "profile", ""] }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List Tasks - as Admin (all)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_access}}" }] },
            "url": { "raw": "{{base_url}}/api/tasks/", "host": ["{{base_url}}"], "path": ["api", "tasks", ""] }
          }
        },
        {
          "name": "List Tasks - as Manager (own + team)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{manager_access}}" }] },
            "url": { "raw": "{{base_url}}/api/tasks/", "host": ["{{base_url}}"], "path": ["api", "tasks", ""] }
          }
        },
        {
          "name": "List Tasks - as User (own only)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{user_access}}" }] },
            "url": { "raw": "{{base_url}}/api/tasks/", "host": ["{{base_url}}"], "path": ["api", "tasks", ""] }
          }
        },
        {
          "name": "Create Task - as User (self)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('task_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{user_access}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prep demo\",\n  \"description\": \"Prepare the client demo deck\",\n  \"assigned_to\": {{user_id}}\n}"
            },
            "url": { "raw": "{{base_url}}/api/tasks/", "host": ["{{base_url}}"], "path": ["api", "tasks", ""] }
          }
        },
        {
          "name": "Create Task - as Manager (for team member)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{manager_access}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Follow up with lead\",\n  \"description\": \"Call back the enterprise lead\",\n  \"assigned_to\": {{user_id}}\n}"
            },
            "url": { "raw": "{{base_url}}/api/tasks/", "host": ["{{base_url}}"], "path": ["api", "tasks", ""] }
          }
        },
        {
          "name": "Update Task - as Owner",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{user_access}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/tasks/{{task_id}}/", "host": ["{{base_url}}"], "path": ["api", "tasks", "{{task_id}}", ""] }
          }
        },
        {
          "name": "Update Task - as Owner's Manager",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{manager_access}}" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DONE\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/tasks/{{task_id}}/", "host": ["{{base_url}}"], "path": ["api", "tasks", "{{task_id}}", ""] }
          }
        },
        {
          "name": "Delete Task - as Manager (expect 403)",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{manager_access}}" }] },
            "url": { "raw": "{{base_url}}/api/tasks/{{task_id}}/", "host": ["{{base_url}}"], "path": ["api", "tasks", "{{task_id}}", ""] }
          }
        },
        {
          "name": "Delete Task - as Admin",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_access}}" }] },
            "url": { "raw": "{{base_url}}/api/tasks/{{task_id}}/", "host": ["{{base_url}}"], "path": ["api", "tasks", "{{task_id}}", ""] }
          }
        }
      ]
    }
  ]
}
